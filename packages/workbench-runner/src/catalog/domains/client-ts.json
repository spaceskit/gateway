{
  "domain_id": "client-ts",
  "description": "TypeScript SDK runtime smoke coverage against the running gateway baseline.",
  "scenarios": [
    {
      "domain_id": "client-ts",
      "scenario_id": "client-ts.runtime-smoke",
      "adapter": "bun",
      "order": 10,
      "blocking": false,
      "platform": "host",
      "requires": ["gateway-core.assert-sync-import"],
      "tasks": [],
      "tags": ["client-ts", "runtime", "baseline"],
      "artifacts": [],
      "config": {
        "command": "bun run test:runtime-smoke",
        "cwd": "client-ts",
        "env": {
          "SPACESKIT_MAIN_GATEWAY_WS_URL": "${SPACESKIT_MAIN_GATEWAY_WS_URL}",
          "SPACESKIT_REQUIRE_EXPLICIT_DEVICE_AUTH": "${SPACESKIT_REQUIRE_EXPLICIT_DEVICE_AUTH}"
        },
        "timeout_ms": 600000
      }
    }
  ]
}
